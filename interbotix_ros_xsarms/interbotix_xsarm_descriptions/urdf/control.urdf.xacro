<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <ros2_control name="XSHardwareInterface" type="system">

    <hardware>

      <!-- If we are using the actual, physical robot -->
      <xacro:if value="${hardware_type == 'actual'}">
        <plugin>interbotix_xs_ros_control/XSHardwareInterface</plugin>
        <param name="node_name">vx300s_interface</param>
        <param name="loop_hz">10</param>
        <param name="group_name">arm</param>
        <param name="gripper_name">gripper</param>
        <param name="joint_states_topic">joint_states</param>
      </xacro:if>

      <!-- If doing basic simulation of the robot -->
      <xacro:if value="${hardware_type == 'fake'}">
        <plugin>fake_components/GenericSystem</plugin>
      </xacro:if>

      <!-- If simulating the robot in Gazebo Classic -->
      <xacro:if value="${hardware_type == 'gz_classic'}">
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </xacro:if>

    </hardware>

    <joint name="waist">
      <command_interface name="position">
        <param name="min">"${waist_limit_lower}"</param>
        <param name="max">"${waist_limit_upper}"</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>

    <joint name="shoulder">
      <command_interface name="position">
        <param name="min">"${shoulder_limit_lower}"</param>
        <param name="max">"${shoulder_limit_upper}"</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">-1.50</param>
      </state_interface>
    </joint>

    <joint name="elbow">
      <command_interface name="position">
        <param name="min">"${elbow_limit_lower}"</param>
        <param name="max">"${elbow_limit_upper}"</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">1.55</param>
      </state_interface>
    </joint>

    <xacro:if value="${dof >= 6}">
      <joint name="forearm_roll">
        <command_interface name="position">
          <param name="min">"${forearm_roll_limit_lower}"</param>
          <param name="max">"${forearm_roll_limit_upper}"</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>
    </xacro:if>

    <joint name="wrist_angle">
      <command_interface name="position">
        <param name="min">"${wrist_angle_limit_lower}"</param>
        <param name="max">"${wrist_angle_limit_upper}"</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.5</param>
      </state_interface>
    </joint>

    <xacro:if value="${dof >= 5}">
      <joint name="wrist_rotate">
        <command_interface name="position">
          <param name="min">"${wrist_rotate_limit_lower}"</param>
          <param name="max">"${wrist_rotate_limit_upper}"</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>
    </xacro:if>

    <xacro:if value="$(arg use_gripper)">
      <!-- Gazebo (gz_classic): the gripper joints are NOT in this block. They have their own
           ros2_control block, GripperHardwareInterface, in
           misskal_description/urdf/control/ros2_control.urdf.xacro (arm / gimbal / gripper split).
           actual: identical to the robot (feat/gripper_controller).
           TODO(real): stage E3 removes left_finger and gripper_name from the actual block (the
           gripper moves to misskal_gripper_node); needs the XSHardwareInterface patch first.
           See misskal_sim study/gripper_sim_integration/TODO_REAL.md (TR-01, TR-08). -->
      <xacro:if value="${hardware_type == 'fake'}">
        <joint name="gripper">
          <command_interface name="position"/>
          <state_interface name="position"/>
        </joint>
      </xacro:if>

      <xacro:if value="${hardware_type != 'gz_classic'}">
        <xacro:if value="$(arg show_gripper_fingers)">
          <joint name="left_finger">
            <command_interface name="position">
              <param name="min">"${finger_limit_lower}"</param>
              <param name="max">"${-finger_limit_lower}"</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="effort"/>
            <state_interface name="velocity">
              <param name="initial_value">0.0</param>
            </state_interface>
          </joint>
        </xacro:if>
      </xacro:if>
    </xacro:if>

  </ros2_control>

  <!-- The robot-level Gazebo plugin is provided by the Clearpath platform xacro
       (see clearpath_platform_description/urdf/generic/gazebo.urdf.xacro). Do not
       add a second gz_ros2_control plugin here for gz_classic, because it loads the
       wrong library and prevents the controller manager from exposing the joints.
  -->
  <xacro:if value="${hardware_type == 'gz_classic'}">
    <gazebo>
      <!-- intentionally left blank: plugin is provided by the platform-level gz plugin -->
    </gazebo>
    <xacro:include filename="$(find interbotix_common_sim)/media/materials/scripts/interbotix_texture.gazebo"/>
  </xacro:if>

</robot>
